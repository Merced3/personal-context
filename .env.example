# Database connection URL. Defaults to a local SQLite database for development.
# For Postgres, use: postgresql+psycopg://user:password@localhost:5432/context_substrate
DATABASE_URL=sqlite:///./data/context_substrate.db

# Upstream discord-hub Archive API (ADR 0012)
DISCORD_HUB_URL=http://127.0.0.1:8000
DISCORD_HUB_TOKEN=replace-with-archive-reader-bearer-token

# Comma-separated list of Discord channel/forum IDs to sync (optional; if empty, syncs all granted channels)
SYNC_CHANNEL_IDS=

# Optional JSON mapping of channel_id -> human-readable source name
# Example: {"1411955142529384530": "my-timeline", "1411955142529384531": "mission"}
SYNC_CHANNEL_NAMES={}

# Pagination page sizes
SYNC_MESSAGES_PAGE_SIZE=50
SYNC_EVENTS_PAGE_SIZE=100
