# Local SQLite default for development; use postgresql+psycopg://... in production.
DATABASE_URL=sqlite:///./data/context_substrate.db

# Upstream discord-hub Archive API (ADR 0012)
DISCORD_HUB_URL=http://127.0.0.1:8000
DISCORD_HUB_TOKEN=replace-with-archive-reader-token

# Optional comma-separated channel IDs to sync (leave empty to sync all granted channels)
SYNC_CHANNEL_IDS=

# Optional JSON map of channel_id -> human source name (e.g. {"1411955142529384530":"my-timeline"})
SYNC_CHANNEL_NAMES={"1411955142529384530":"my-timeline","1411955142529384531":"mission"}

# Page sizes for incremental sync
SYNC_MESSAGES_PAGE_SIZE=50
SYNC_EVENTS_PAGE_SIZE=100

# HTTP API server
API_HOST=127.0.0.1
API_PORT=8010

# Per-consumer bearer tokens (JSON map: consumer_name -> secret_token)
CONSUMER_TOKENS={"socratic-partner":"replace-me-token-1","operator":"replace-me-token-2"}

# Background sync & automation-harness runtime
SYNC_INTERVAL_SECONDS=300
HARNESS_DATA_DIR=./data/harness
# Optional Postgres URL for off-box harness state (leave empty for local SQLite)
HARNESS_DATABASE_URL=
